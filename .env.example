# REQUIRED: signed application sessions (at least 32 random characters).
SESSION_SECRET=
# Supabase integration variables. Add your Supabase database to Vercel,
# then copy these from its connected Environment Variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy Supabase projects can use SUPABASE_SERVICE_ROLE_KEY in place of SUPABASE_SECRET_KEY.
# Optional: only your wallet can access /admin; NOT a shared public password.
ADMIN_WALLET_ADDRESS=
# Server-side Claude analysis. Never expose in browser code.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
BASE_SEPOLIA_RPC=https://sepolia.base.org
PUBLIC_ORIGIN=
PORT=3000

# Base Mainnet balance and activity lookup. Reads never initiate transactions.
BASE_MAINNET_RPC=https://mainnet.base.org
# Optional Blockscout PRO API key (free starter tier where available).
# Enables indexed recent Base transactions, ETH/gas samples and counterparties.
# Do not expose this key to the browser. Without it, show balance and nonce only.
BLOCKSCOUT_API_KEY=
