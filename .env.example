# Copy placeholders to .env for local development. NEVER commit real values.
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
PUBLIC_ORIGIN=http://localhost:3000
# Supabase project settings (server-side, never serve secret key to the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Optional for Claude's risk explanations and advanced case analysis
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
CLAUDE_MODEL=claude-sonnet-4-6
# Optional for recent indexed transactions and repeated counterparties
BLOCKSCOUT_API_KEY=REPLACE_WITH_BLOCKSCOUT_KEY
# Optional RPC overrides (default endpoints shown)
BASE_MAINNET_RPC=https://mainnet.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Optional single operator wallet; never required for public accounts
ADMIN_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
