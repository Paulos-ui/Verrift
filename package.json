{
  "name": "verrift",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VERRIFT: Base token due diligence, wallet allowance intelligence, and verifiable permission changes",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch scripts/dev-server.js",
    "start": "node --env-file-if-exists=.env scripts/dev-server.js",
    "setup": "node scripts/setup.js",
    "lint": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/check.js",
    "verify": "npm run lint && npm test && npm run build"
  },
